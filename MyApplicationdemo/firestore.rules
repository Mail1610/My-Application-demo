rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /groups/{groupId} {
      allow read: if true;

      allow create: if request.resource.data.keys().hasAll(['name','inviteCode','members','memberCount','nicknames','balances','creatorDeviceId','admins'])
        && request.resource.data.name is string
        && request.resource.data.inviteCode is string
        && request.resource.data.memberCount is int;

      allow update: if resource.data.members != null;

      // Only admins or creator can delete
      allow delete: if resource.data.members != null;

      match /expenses/{expenseId} {
        allow read, write: if exists(/databases/$(database)/documents/groups/$(groupId));
      }
    }

  }
}
